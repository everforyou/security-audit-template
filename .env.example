# Optional local credentials and endpoints for this audit workspace.
# Copy this file to .env; .env is ignored by Git. Never put real values here.
# Add or remove names to match the approved tools and test identities for this audit.
# Use only credentials and services allowed by SCOPE.md.
# Uncomment and fill only the names consumed by your tooling.

# Audit tooling or service credentials
# AUDIT_TOOL_API_KEY=

# Authorized target test environment / identity
# TARGET_BASE_URL=
# TARGET_API_TOKEN=
# TARGET_TEST_USERNAME=
# TARGET_TEST_PASSWORD=
# TARGET_RPC_URL=
